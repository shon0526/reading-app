# reading_app_api ロールでの接続（ローカル Supabase の例。パスワードはマイグレーション後に設定）
DATABASE_URL=postgresql+psycopg://reading_app_api:change-me@127.0.0.1:54322/postgres
# Supabase プロジェクト URL（JWKS 取得用。ローカルは supabase start の API URL）
SUPABASE_URL=http://127.0.0.1:54321
CORS_ORIGINS=http://localhost:5173
# 以下はローカルのみ（Render には置かない）
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
